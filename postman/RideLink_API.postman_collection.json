    {
      "name": "04 - Ride Management Service (Member 3 - IT24104016)",
      "item": [
        {
          "name": "1. Request Ride (E2E Auto Assignment)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Ride requested and driver assigned', function() {",
                  "    pm.response.to.have.status(201);",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.status).to.be.oneOf(['ASSIGNED', 'REQUESTED']);",
                  "    pm.environment.set('rideId', json.id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"passengerId\": \"{{passengerId}}\",\n  \"serviceArea\": \"Colombo\",\n  \"pickupLocation\": {\n    \"latitude\": 6.9271,\n    \"longitude\": 79.8612,\n    \"address\": \"Colombo Fort Station\"\n  },\n  \"destinationLocation\": {\n    \"latitude\": 6.8652,\n    \"longitude\": 79.8598,\n    \"address\": \"Dehiwala Junction\"\n  }\n}"
            },
            "url": {
              "raw": "{{ride_service_url}}/api/v1/rides/request",
              "host": ["{{ride_service_url}}"],
              "path": ["api", "v1", "rides", "request"]
            }
          }
        },
        {
          "name": "2. Get Ride Details",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{ride_service_url}}/api/v1/rides/{{rideId}}",
              "host": ["{{ride_service_url}}"],
              "path": ["api", "v1", "rides", "{{rideId}}"]
            }
          }
        },
        {
          "name": "3. Driver Accepts Ride",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is ACCEPTED', function() {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().status).to.eql('ACCEPTED');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{ride_service_url}}/api/v1/rides/{{rideId}}/accept?driverId={{driverId}}",
              "host": ["{{ride_service_url}}"],
              "path": ["api", "v1", "rides", "{{rideId}}", "accept"],
              "query": [
                {
                  "key": "driverId",
                  "value": "{{driverId}}"
                }
              ]
            }
          }
        },
        {
          "name": "4. Driver Starts Ride",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is IN_PROGRESS', function() {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().status).to.eql('IN_PROGRESS');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{ride_service_url}}/api/v1/rides/{{rideId}}/start",
              "host": ["{{ride_service_url}}"],
              "path": ["api", "v1", "rides", "{{rideId}}", "start"]
            }
          }
        },
        {
          "name": "5. Complete Ride (Triggers Payment & Receipt)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Ride COMPLETED and payment processed', function() {",
                  "    pm.response.to.have.status(200);",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.status).to.eql('COMPLETED');",
                  "    pm.expect(json.paymentId).to.not.be.null;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{ride_service_url}}/api/v1/rides/{{rideId}}/complete",
              "host": ["{{ride_service_url}}"],
              "path": ["api", "v1", "rides", "{{rideId}}", "complete"]
            }
          }
        },
        {
          "name": "[Negative] Invalid State Transition - Start Completed Ride (400 Bad Request)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Invalid transition rejected', function() {",
                  "    pm.response.to.have.status(400);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{ride_service_url}}/api/v1/rides/{{rideId}}/start",
              "host": ["{{ride_service_url}}"],
              "path": ["api", "v1", "rides", "{{rideId}}", "start"]
            }
          }
        },
        {
          "name": "[Negative] Cannot Cancel Completed Ride (400 Bad Request)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Cancellation rejected on completed ride', function() {",
                  "    pm.response.to.have.status(400);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Trying to cancel completed ride\"\n}"
            },
            "url": {
              "raw": "{{ride_service_url}}/api/v1/rides/{{rideId}}/cancel",
              "host": ["{{ride_service_url}}"],
              "path": ["api", "v1", "rides", "{{rideId}}", "cancel"]
            }
          }
        }
      ]
    }
  ]
